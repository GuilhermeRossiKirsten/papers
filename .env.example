# Gere com: npx auth secret
AUTH_SECRET=
# GitHub OAuth App (https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# MongoDB (a integração da Vercel preenche automaticamente)
MONGODB_URI=
MONGODB_DB=clube-do-paper
# Logins do GitHub com acesso ao /admin, separados por vírgula
ADMIN_GITHUB_LOGINS=seu-login,outro-login
